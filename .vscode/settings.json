{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    ".claude": true,
    ".github": true,
    ".vscode": true,
    ".cache": true,
    ".clangd": true,
    ".editorconfig": true,
    "APP/outils": true
